@model WorkshopRSVPLab3.Models.Rsvp

<h1>Workshop RSVP</h1>

<form asp-controller="Workshops"
      asp-action="Confirm"
      method="post">

    <div class="mb-3">
        <label asp-for="FullName"></label>
        <input asp-for="FullName" class="form-control" />
        <span asp-validation-for="FullName"
              class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="WorkshopTitle"></label>
        <input asp-for="WorkshopTitle" class="form-control" />
        <span asp-validation-for="WorkshopTitle"
              class="text-danger"></span>
    </div>

    <div class="form-check mb-3">
        <input asp-for="NeedsAccomodation"
               class="form-check-input" />
        <label asp-for="NeedsAccomodation"
               class="form-check-label"></label>
    </div>

    <button type="submit" class="btn btn-primary">
        Submit RSVP
    </button>
</form>