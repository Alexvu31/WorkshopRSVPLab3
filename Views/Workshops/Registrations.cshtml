@model List<WorkshopRSVPLab3.Models.Rsvp>
@{

    ViewData["Title"] = "Registrations";

}

<h1>Workshop Registrations</h1>

@if (Model.Count == 0)
{
    <p>No registrations yet.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Full Name</th>
                <th>Workshop</th>
                <th>Needs Accomodation</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var registration in Model)
            {
                <tr>
                    <td>@registration.FullName</td>
                    <td>@registration.WorkshopTitle</td>
                    <td>
                        @(registration.NeedsAccomodation ? "Yes" : "No")
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<a asp-controller="Workshops"
asp-action="RsvpForm"
class="btn btn-primary">
Register for a Workshop
</a>

<a asp-controller="Workshops"
asp-action="Index"
class="btn btn-secondary">
Back to Workshops
</a>

